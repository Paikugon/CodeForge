{
    "compile": {
        "src_name": "solution.py",
        "exe_name": "solution.py",
        "max_cpu_time": 3000,
        "max_real_time": 10000,
        "max_memory": 134217728,
        "compile_command": "/usr/bin/python3 -m py_compile {src_path}"
    },
    "run": {
        "command": "/usr/bin/python3 -BS {exe_path}",
        "seccomp_rule": "general",
        "env": [
            "LANG=en_US.UTF-8",
            "LANGUAGE=en_US:en",
            "LC_ALL=en_US.UTF-8"
        ]
    }
}
